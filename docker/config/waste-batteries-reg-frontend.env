# waste-batteries-reg-frontend — service-specific environment variables.
# Shared infrastructure vars (Mongo, Redis, AWS) are in defaults.env.

PORT=3000

# Backend, by its compose service name
WASTE_BATTERIES_REG_BACKEND_URL=http://waste-batteries-reg-backend:8085

# Redis-backed sessions. Each frontend gets its own key prefix because all
# three share one Redis.
SESSION_CACHE_ENGINE=redis
REDIS_KEY_PREFIX=waste-batteries-reg-frontend:

# The production image sets NODE_ENV=production, which makes the session cookie
# Secure. Tests run over plain HTTP, so it must be off or the browser never
# sends the cookie back.
SESSION_COOKIE_SECURE=false

# Defra ID — the server fetches OIDC discovery from the stub container.
DEFRA_ID_DISCOVERY_URL=http://cdp-defra-id-stub:3200/cdp-defra-id-stub/.well-known/openid-configuration
# Browser-facing base URL used to build the auth callback URLs.
DEFRA_ID_CALLBACK_BASE_URL=http://localhost:3000
