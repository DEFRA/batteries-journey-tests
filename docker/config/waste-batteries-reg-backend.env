# waste-batteries-reg-backend — service-specific environment variables.
# Shared infrastructure vars (Mongo, Redis, AWS) are in defaults.env.

ASPNETCORE_URLS=http://+:8085
Mongo__DatabaseUri=mongodb://mongodb:27017/

# Defra ID — bearer tokens are validated against the stub's OIDC metadata.
Jwt__MetadataAddress=http://cdp-defra-id-stub:3200/cdp-defra-id-stub/.well-known/openid-configuration
Jwt__Audience=63983fc2-cfff-45bb-8ec2-959e21062b9a
Jwt__RequireHttpsMetadata=false
